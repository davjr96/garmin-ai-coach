# Environment variables for garmin-ai-coach (example only)
# Copy to .env or .env.dev and fill in real values. Do NOT commit real secrets.

# LLM providers (use at least one)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
DEEPSEEK_API_KEY=...

# Observability (optional)
LANGSMITH_API_KEY=lsv2_...

# App mode: development | standard | cost_effective | pro
# Provider mapping depends on AI mode (see services/ai/ai_settings.py)
# Defaults:
#   standard -> OpenAI (gpt-5 / gpt-5-search)                       | requires OPENAI_API_KEY
#   development -> Anthropic + Google (claude-sonnet-4.6, gemini-2.5-flash) | requires ANTHROPIC_API_KEY + GOOGLE_API_KEY
#   cost_effective -> Anthropic (claude-3-haiku)                     | requires ANTHROPIC_API_KEY
#   pro -> OpenAI (gpt-5.2-pro-search for experts/planners)         | requires OPENAI_API_KEY
#        ⚠️  WARNING: PRO mode can incur high costs (>$10 per run depending on data volume)
# Tip: If you only set OPENAI_API_KEY, set AI_MODE=standard or update model assignments.
AI_MODE=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
